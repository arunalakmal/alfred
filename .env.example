# --- Anthropic (manager + Claude specialists via the Agent SDK) ---
ANTHROPIC_API_KEY="sk-ant-xxx"

# --- Azure OpenAI (via LiteLLM). Also set the deployment name in config/litellm.yaml ---
AZURE_API_KEY=
AZURE_API_BASE=https://<your-resource>.openai.azure.com/
AZURE_API_VERSION=2025-04-01-preview

# --- Gateway ---
LITELLM_MASTER_KEY=""                # must start with sk- ; also the LiteLLM UI password (user: admin)
LITELLM_DB_PASSWORD=""               # Postgres for the LiteLLM UI; any random string

# --- Alfred API: required for anything beyond localhost. Generate with: openssl rand -hex 32
ALFRED_API_KEY=""

# --- Token and cost guards ---
ALFRED_MANAGER_MODEL=sonnet          # default manager tier: haiku | sonnet | opus
ALFRED_MAX_BUDGET_USD=1.0            # hard cap per request, includes all sub-agents
ALFRED_MAX_TURNS=12
ALFRED_MAX_ATTEMPTS=2                # re-runs a reply that declined without trying a specialist
ALFRED_SUBAGENT_DEPTH=1              # specialists cannot spawn further agents
ALFRED_MAX_CONCURRENT_SUBAGENTS=4
ALFRED_LOCAL_ENABLED=true            # route short chat to the local model first
ALFRED_LOCAL_MODEL=ollama-local
ALFRED_DIRECT_MODEL=claude-haiku     # gateway model for single-call answers

# --- Safety ---
ALFRED_ALLOW_SHELL=false             # true lets agents run Bash/Write/Edit inside ./workspace
ALFRED_AUTO_APPROVE_AGENTS=false     # agents Alfred proposes wait for your approval

# --- Remote access (docker compose --profile remote) ---
TS_AUTHKEY=
